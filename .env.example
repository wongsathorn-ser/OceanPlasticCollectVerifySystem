# Copy this file to .env (PowerShell: copy .env.example .env) and adjust.
# .env is ignored by git - never commit real passwords (NFR-20).
# docker compose reads it; on Render set the same names in the dashboard.

# ---------- Database: PostgreSQL for now (docs/DECISIONS.md D1) ----------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=appdb

# compose builds DATABASE_URL for the backend from the values above.
# Set it yourself only when running the backend outside Docker, e.g.
# DATABASE_URL=postgresql://appuser:change-me-local-only@localhost:54242/appdb
# If the team switches to MySQL later (needs mysql-connector-python):
# DATABASE_URL=mysql+mysqlconnector://appuser:change-me-local-only@localhost:54242/appdb

# ---------- Backend ----------
# Leave empty while frontend and API share one origin (Vite proxy / Render rewrite)
CORS_ORIGINS=
SESSION_COOKIE_NAME=ocean_session
SESSION_TTL_DAYS=7
# false for local http://localhost, true on Render (HTTPS)
COOKIE_SECURE=false

# ---------- Default admin created by the seed script (FR-1.9) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-only
