# =====================================================================
#  OceanPlasticCollectVerifySystem - files that must never be committed
# =====================================================================

# ---------- Secrets and local environment (NFR-20: no secrets in git) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python / FastAPI (server) ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
.eggs/
build/

# ---------- Node / React (client) ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Logs ----------
logs/
*.log

# ---------- Local data, uploads, database files ----------
uploads/
*.sqlite
*.sqlite3
*.db
*.dump

# ---------- Docker (personal overrides) ----------
compose.override.yaml
docker-compose.override.yml

# ---------- Editors / IDEs ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.suo
*.sln
*.njsproj
*.ntvs*

# ---------- Operating systems ----------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
